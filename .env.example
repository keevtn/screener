# Financial News Screener — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.

# --- Datastores -------------------------------------------------------------
# MongoDB Atlas connection string (durable news_items archive + read API).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# Redis (rolling recency-sentiment; only needed when RUN_REDIS=true).
REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_URI=redis://default:<password>@<host>:<port>

# --- Third-party API keys ---------------------------------------------------
STOCKTWITS_API_KEY=<optional-stocktwits-key>
FINVIZ_AUTH_TOKEN=<optional-finviz-elite-export-url-with-auth>
# LLM / agent keys (only if you wire up the agent paths).
ANTHROPIC_API_KEY=<sk-ant-...>
AGENT_API_KEY=<internal-agent-key>

# --- Alpaca (price bars + PAPER trading) ------------------------------------
# Used by: the market-data client (intraday bars), the paper-trading sim, AND
# the read-only TRADER dashboard view. All Alpaca access is PAPER-only and, in
# the web backend, strictly read-only (account/positions/orders/portfolio-history
# /clock) — order placement lives with the local driver + human gate. Absent →
# the TRADER tab shows a "connect Alpaca keys" empty state; news + screener still
# work. Use PAPER account keys only. NEVER commit real values.
ALPACA_API_KEY=<alpaca-paper-key-id>
ALPACA_API_SECRET=<alpaca-paper-secret>
# Arm the in-pipeline paper-sim step (run_pipeline). Does NOT gate the standing driver.
SIM_ENABLED=false
# LIVE paper trading: the standing daily driver (scripts/run_trader.py). Default off
# = the app service serves the API + pipeline but never trades. When true, ONE driver
# trades this Alpaca paper account — keep any OTHER driver (e.g. local) OFF. Unset +
# restart to stop trading instantly. Order placement is never reachable over HTTP.
TRADER_DRIVER_ENABLED=false
# TRADER_DRIVER_SWEEP_S=60   # optional: seconds between entry/exit sweeps (min 5)

# --- Service auth (protect any exposed endpoints) ---------------------------
BASIC_AUTH_USER=<username>
BASIC_AUTH_PASS=<strong-password>

# --- SEC fair-access (required — SEC throttles anonymous clients) -----------
SEC_CONTACT_EMAIL=you@example.com

# --- Pipeline toggles (see docs/middleware-api.md) --------------------------
RUN_INGESTION=false
RUN_SOCIAL=false
RUN_REDIS=false
RUN_REDDIT=false
RUN_STOCKTWITS=false
RUN_BLUESKY=true
# Optional schedulers (present in .env; wire up as those features land).
RUN_CATALYST_SCHEDULER=false
RUN_SQUEEZE_SCHEDULER=false
RUN_TRENDS=false

# --- Safety + model selection ------------------------------------------------
# OFF until the intended cluster URI is in MONGODB_URI. See docs/storage.md.
ALLOW_MONGO_WRITES=false
# In-process ingestion scorer: finbert | lm. (CLI defaults to finbert on its own.)
SENTIMENT_ANALYZER=lm
